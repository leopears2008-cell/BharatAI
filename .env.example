# Required: Gemini API key (server-side only; never expose to the browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required: secret used to sign session cookies. Min 32 chars. The app refuses to
# create or verify sessions without it. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Optional: model name sent to the provider. This is also the model reported to users
# and in /api/v1/chat/completions responses.
MODEL_NAME="gemini-3.6-flash"

# Optional: enables /api/v1/chat/completions. Comma-separated SHA-256 hex hashes of
# the API keys you issue (never store raw keys). Hash a key with:
#   printf '%s' 'bl_live_yourkey' | sha256sum
API_KEY_HASHES=""

# Optional: comma-separated browser origins allowed to call the public API (CORS).
# Empty = no cross-origin browser access.
ALLOWED_ORIGINS=""

# APP_URL: URL where this app is hosted.
APP_URL="MY_APP_URL"
